{
  "version": "1.0.0",
  "system_config": {
    "max_forward_chain_iterations": 100,
    "enable_debug_logging": false,
    "strict_validation": true
  },
  "distance_limits": {
    "min_workout_distance_miles": 2.0,
    "max_weekly_mileage_miles": 250.0,
    "max_single_workout_miles": 50.0
  },
  "training_limits": {
    "max_days_per_week": 7,
    "min_rest_days_recommended": 1
  },
  "safety_multipliers": {
    "long_run_max_multiplier": 1.5,
    "tempo_run_max_multiplier": 0.4,
    "interval_run_max_multiplier": 0.3,
    "easy_run_max_multiplier": 0.5
  },
  "experience_levels": {
    "beginner": {
      "min_weekly_mileage": 0,
      "max_weekly_mileage": 30,
      "max_long_run": 13,
      "can_do_high_intensity": false,
      "description": "Less than 1 year of consistent running OR training for first race"
    },
    "intermediate": {
      "min_weekly_mileage": 20,
      "max_weekly_mileage": 50,
      "max_long_run": 18,
      "can_do_high_intensity": true,
      "description": "1-3 years of consistent running OR completed 2+ races"
    },
    "advanced": {
      "min_weekly_mileage": 40,
      "max_weekly_mileage": 200,
      "max_long_run": 26,
      "can_do_high_intensity": true,
      "description": "3+ years of consistent running OR completed 5+ races including marathons"
    }
  },
  "terrain_preferences": {
    "comment": "Ordered from best to worst for each injury type",
    "shin_splints": ["treadmill", "trail", "road", "track"],
    "knee_injury": ["treadmill", "road", "track", "trail"],
    "plantar_fasciitis": ["treadmill", "trail", "track", "road"],
    "it_band_syndrome": ["treadmill", "road", "trail", "track"],
    "achilles_tendonitis": ["treadmill", "road", "trail", "track"],
    "hip_injury": ["treadmill", "road", "trail", "track"],
    "hamstring_injury": ["treadmill", "road", "trail", "track"],
    "calf_injury": ["treadmill", "trail", "road", "track"],
    "ankle_injury": ["treadmill", "road", "track", "trail"],
    "back_injury": ["treadmill", "trail", "road", "track"],
    "default": ["treadmill", "trail", "road", "track"]
  },
  "workout_types": {
    "easy_run": {
      "intensity": "low",
      "aliases": ["easy", "easy run", "recovery"],
      "requires_base": false
    },
    "long_run": {
      "intensity": "medium",
      "aliases": ["long", "long run"],
      "requires_base": true
    },
    "tempo": {
      "intensity": "high",
      "aliases": ["tempo", "threshold", "tempo run"],
      "requires_base": true
    },
    "intervals": {
      "intensity": "high",
      "aliases": ["intervals", "interval", "speed work"],
      "requires_base": true
    }
  },
  "severity_levels": {
    "critical": {
      "level": 4,
      "description": "Immediate health risk - must stop",
      "can_suggest_alternative": false
    },
    "high": {
      "level": 3,
      "description": "High injury risk - needs modification",
      "can_suggest_alternative": true
    },
    "medium": {
      "level": 2,
      "description": "Moderate concern - caution advised",
      "can_suggest_alternative": true
    },
    "none": {
      "level": 0,
      "description": "No safety concerns",
      "can_suggest_alternative": false
    }
  },
  "race_taper": {
    "days_before_race_warning": 7,
    "max_long_run_days_before": 14,
    "recommended_rest_days_before": 2
  },
  "recovery_guidelines": {
    "hours_between_hard_workouts": 48,
    "sleep_quality_threshold": "fair",
    "hydration_required": true,
    "proper_footwear_required": true
  },
  "weather_thresholds": {
    "extreme_heat_f": 90,
    "extreme_cold_f": 20,
    "wind_chill_warning": true
  },
  "known_injuries": [
    "shin splints",
    "knee injury",
    "runner's knee",
    "plantar fasciitis",
    "IT band syndrome",
    "ITB syndrome",
    "achilles tendonitis",
    "stress fracture",
    "hip injury",
    "hamstring injury",
    "calf injury",
    "quad injury",
    "ankle injury",
    "foot injury",
    "back injury"
  ],
  "critical_symptoms": [
    "chest_pain",
    "chest pain",
    "dizziness",
    "severe shortness of breath",
    "irregular heartbeat"
  ],
  "validation_rules": {
    "require_experience_level": true,
    "require_weekly_mileage": true,
    "require_available_terrain_if_injured": true,
    "validate_input_types": true,
    "allow_unknown_injuries": true
  },
  "alternative_generation": {
    "max_attempts": 5,
    "prefer_terrain_swap": true,
    "prefer_distance_reduction": true,
    "prefer_workout_type_swap": false,
    "minimum_practical_distance": 2.0
  },
  "messages": {
    "safe_workout": "Workout meets all safety criteria",
    "input_validation_failed": "Invalid input: {error}",
    "no_workout_provided": "No proposed workout provided",
    "chest_pain_warning": "Seek immediate medical attention for chest pain. Do not exercise.",
    "dizziness_warning": "Dizziness requires medical evaluation. Rest until cleared by doctor.",
    "uncleared_injury_warning": "Active injuries require medical clearance before training.",
    "rest_recommended": "Rest recommended to prevent injury. Resume training when conditions improve.",
    "extreme_weather_warning": "Extreme heat or cold increases risk of heat illness or hypothermia"
  },
  "debug": {
    "log_fact_extraction": false,
    "log_rule_firing": false,
    "log_inference_chain": false,
    "verbose_alternatives": false
  }
}